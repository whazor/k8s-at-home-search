mage.pullPolicy":{"0":["IfNotPresent"]},"controllers.paperless.containers.gotenberg.image.repository":{"0":["docker.io/gotenberg/gotenberg"]},"controllers.paperless.containers.gotenberg.image.tag":{"0":["8.26.0"]},"controllers.paperless.containers.gotenberg.env[].name":{"0":["CHROMIUM_DISABLE_ROUTES"]},"controllers.paperless.containers.gotenberg.env[].value":{"0":["1"]},"service.paperless.controller":{"0":["paperless"]},"service.paperless.ports.http.port":{"0":["8000"]},"persistence.data.enabled":{"0":["true"]},"persistence.data.globalMounts[].path":{"0":["/usr/src/paperless/data"]},"persistence.data.accessMode":{"0":["ReadWriteOnce"]},"persistence.data.storageClass":{"0":["openebs-jiva-csi-default"]},"persistence.data.size":{"0":["3Gi"]},"persistence.media.enabled":{"0":["true"]},"persistence.media.globalMounts[].path":{"0":["/usr/src/paperless/media"]},"persistence.media.accessMode":{"0":["ReadWriteOnce"]},"persistence.media.storageClass":{"0":["openebs-jiva-csi-default"]},"persistence.media.size":{"0":["15Gi"]},"persistence.export.enabled":{"0":["true"]},"persistence.export.globalMounts[].path":{"0":["/usr/src/paperless/export"]},"persistence.export.accessMode":{"0":["ReadWriteOnce"]},"persistence.export.storageClass":{"0":["nfs"]},"persistence.export.size":{"0":["20Gi"]},"persistence.consume.globalMounts[].path":{"0":["/consume"]},"persistence.consume.existingClaim":{"0":["nfs-paperless-consume"]},"persistence.custom-scripts.name":{"0":["paperless-ng-custom-scripts"]},"persistence.custom-scripts.enabled":{"0":["true"]},"persistence.custom-scripts.type":{"0":["secret"]},"persistence.custom-scripts.defaultMode":{"0":["777"]},"persistence.custom-scripts.globalMounts[].path":{"0":["/usr/src/paperless/custom-scripts"]},"secrets.custom-scripts.enabled":{"0":["true"]},"secrets.custom-scripts.suffix":{"0":["custom-scripts"]},"secrets.custom-scripts.stringData.docker-entrypoint#sh":{"0":["#!/usr/bin/env bash\n\nset -e\n\ninstall_packages() {\n  echo \"Installing packages...\"\n\n  local packages=\"$1\"\n  read -ra packages <<<\"$packages\"\n\n  # Check that it is not empty\n  if [ ${#packages[@]} -eq 0 ]; then\n    return\n  fi\n  apt-get update\n\n  for package in \"${packages[@]}\"; do\n    pkg=\"$package\"\n\n    if dpkg -s \"$pkg\" &>/dev/null; then\n      echo \"Package $pkg already installed!\"\n      continue\n    fi\n\n    if ! apt-cache show \"$pkg\" &>/dev/null; then\n      echo \"Package $pkg not found! :(\"\n      continue\n    fi\n\n    echo \"Installing package $pkg...\"\n    if ! apt-get -y install \"$pkg\" &>/dev/null; then\n      echo \"Could not install $pkg\"\n      exit 1\n    fi\n  done\n}\n\n# Install additional packages if specified\nif [[ -n \"$PAPERLESS_CUSTOM_PACKAGES\" ]]; then\n  install_packages \"$PAPERLESS_CUSTOM_PACKAGES\"\nfi\n\nexec \"/init\""]},"secrets.custom-scripts.stringData.pdf_rm_blank#sh":{"0":["#!/usr/bin/env bash\n\nDOCUMENT_FILE_NAME=${1}\n\necho \"\nDocument ${DOCUMENT_ID} is about to be consumed.\n\"\n\nIN=\"$DOCUMENT_FILE_NAME\"\nOUT=\"${DOCUMENT_FILE_NAME}_tmp\"\nPAGES=$(pdfinfo \"$IN\" | grep ^Pages: | tr -dc '0-9')\necho \"Starting to remove blank pages from $IN\"\nnon_blank() {\n    for i in $(seq 1 $PAGES)\n    do\n        if [ $(convert -density 25 \"$IN[$((i-1))]\" -define histogram:unique-colors=true -format %c histogram:info:- | wc -l) -gt 100 ]\n        then\n            echo $i\n            #echo $i 1>&2\n        fi\n        echo -n . 1>&2\n    done | tee out.tmp\n    echo 1>&2\n}\n\nset +x\npdftk \"$IN\" cat $(non_blank) output \"$OUT\"\nrm out.tmp\nmv \"$OUT\" \"$IN\"\necho \"finishing removing blank pages from $IN\""]},"secrets.custom-scripts.stringData.paperless_post_consume#sh":{"0":["#!/usr/bin/env bash\n\necho \"\nA document with an id of ${DOCUMENT_ID} was just consumed.  I know the\nfollowing additional information about it:\n* Generated File Name: ${DOCUMENT_FILE_NAME}\n* Archive Path: ${DOCUMENT_ARCHIVE_PATH}\n* Source Path: ${DOCUMENT_SOURCE_PATH}\n* Created: ${DOCUMENT_CREATED}\n* Added: ${DOCUMENT_ADDED}\n* Modified: ${DOCUMENT_MODIFIED}\n* Thumbnail Path: ${DOCUMENT_THUMBNAIL_PATH}\n* Download URL: ${DOCUMENT_DOWNLOAD_URL}\n* Thumbnail URL: ${DOCUMENT_THUMBNAIL_URL}\n* Correspondent: ${DOCUMENT_CORRESPONDENT}\n* Tags: ${DOCUMENT_TAGS}\nIt was consumed with the passphrase ${PASSPHRASE}\n\"\n/usr/src/paperless/custom-scripts/shrinkpdf.sh ${DOCUMENT_ARCHIVE_PATH} ${DOCUMENT_ARCHIVE_PATH}_shrinked 200\nmv ${DOCUMENT_ARCHIVE_PATH}_shrinked ${DOCUMENT_ARCHIVE_PATH}"]},"secrets.custom-scripts.stringData.shrinkpdfhere#sh":{"0":["#!/bin/sh              \ndpi=${1:-150}\nfind . -type f -name '*.pdf' -exec sh -c '/usr/src/paperless/custom-scripts/shrinkpdf.sh \"$1\" \"$(dirname \"$1\")\"/\"$(basename \"$1\" .pdf)\".compressed.pdf $2' sh {} \"$dpi\" \\;"]},"secrets.custom-scripts.stringData.shrinkpdf#sh":{"0":["#!/bin/sh\nshrink ()\n{\n        gs                                      \\\n          -q -dNOPAUSE -dBATCH -dSAFER          \\\n          -sDEVICE=pdfwrite                     \\\n          -dCompatibilityLevel=1.3              \\\n          -dPDFSETTINGS=/screen                 \\\n          -dEmbedAllFonts=true                  \\\n          -dSubsetFonts=true                    \\\n          -dAutoRotatePages=/None               \\\n          -dColorImageDownsampleType=/Bicubic   \\\n          -dColorImageResolution=$3             \\\n          -dGrayImageDownsampleType=/Bicubic    \\\n          -dGrayImageResolution=$3              \\\n          -dMonoImageDownsampleType=/Subsample  \\\n          -dMonoImageResolution=$3              \\\n          -sOutputFile=\"$2\"                     \\\n          \"$1\"\n}\n\ncheck_smaller ()\n{\n        # If $1 and $2 are regular files, we can compare file sizes to\n        # see if we succeeded in shrinking. If not, we copy $1 over $2:\n        if [ ! -f \"$1\" -o ! -f \"$2\" ]; then\n                return 0;\n        fi\n        ISIZE=\"$(echo $(wc -c \"$1\") | cut -f1 -d\\ )\"\n        OSIZE=\"$(echo $(wc -c \"$2\") | cut -f1 -d\\ )\"\n        if [ \"$ISIZE\" -lt \"$OSIZE\" ]; then\n                echo \"Input smaller than output, doing straight copy\" >&2\n                cp \"$1\" \"$2\"\n        fi\n}\n\nusage ()\n{\n        echo \"Reduces PDF filesize by lossy recompressing with Ghostscript.\"\n        echo \"Not guaranteed to succeed, but usually works.\"\n        echo \"  Usage: $1 infile [outfile] [resolution_in_dpi]\"\n}\n\nIFILE=\"$1\"\n\n# Need an input file:\nif [ -z \"$IFILE\" ]; then\n        usage \"$0\"\n        exit 1\nfi\n\n# Output filename defaults to \"-\" (stdout) unless given:\nif [ ! -z \"$2\" ]; then\n        OFILE=\"$2\"\nelse\n        OFILE=\"-\"\nfi\n\n# Output resolution defaults to 72 unless given:\nif [ ! -z \"$3\" ]; then\n        res=\"$3\"\nelse\n        res=\"72\"\nfi\n\nshrink \"$IFILE\" \"$OFILE\" \"$res\" || exit $?\n\ncheck_smaller \"$IFILE\" \"$OFILE\""]}}},"chartName":"app-template","helmRepoName":"","helmRepoURL":"https://bjw-s-labs.github.io/helm-charts"},"/hr/bjw-s-labs.github.io-helm-charts-app-template-spliit":{"title":"spliit helm release","name":"spliit","key":"bjw-s-labs.github.io-helm-charts-app-template-spliit","repos":[{"name":"spliit","repo":"PixelJonas/cluster-gitops","helm_repo_name":"","helm_repo_url":"https://bjw-s-labs.github.io/helm-charts","url":"https://github.com/PixelJonas/cluster-gitops/blob/master/manifests/argocd/apps/spliit/base/apps/spliit.yaml","chart_version":"4.6.2","repo_url":"https://github.com/PixelJonas/cluster-gitops","stars":13,"icon":null,"group":null,"timestamp":"1768626273"}],"values":{"list":[{"name":"controllers.spliit.containers.spliit.env.POSTGRES_DB","count":1,"types":["string"],"urls":[0]},{"name":"controllers.spliit.containers.spliit.env.POSTGRES_HOST","count":1,"types":["string"],"urls":[0]},{"name":"controllers.spliit.containers.spliit.env.POSTGRES_PASSWORD.valueFrom.secretKeyRef.key","count":1,"types":["string"],"urls":[0]},{"name":"controllers.spliit