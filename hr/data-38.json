ources.limits.memory":{"0":["512Mi"]},"configMaps.kubevirt-manager.enabled":{"0":["true"]},"configMaps.kubevirt-manager.data.oauth2#conf":{"0":["auth_request /internal-auth/;\nauth_request_set $auth_redirect_url $upstream_http_location;\nauth_request_set $auth_status $upstream_status;\nerror_page 401 = /oauth2/start?rd=https://$host$request_uri;\n"]},"configMaps.kubevirt-manager.data.default#conf":{"0":["map $http_upgrade $connection_upgrade {\n    default upgrade;\n    '' close;\n}\n\nserver {\n    listen 8080 default_server;\n    listen [::]:8080 default_server;\n\n    add_header Allow \"GET, POST, HEAD, PUT, DELETE, PATCH\" always;\n    if ($request_method !~ ^(GET|POST|HEAD|PUT|DELETE|PATCH)$) {\n        return 405;\n    }\n\n    server_name  _;\n    root /usr/share/nginx/html;\n    index index.html index.htm;\n\n    location ^~ /oauth2/ {\n        proxy_buffer_size   128k;\n        proxy_buffers   16 256k;\n        proxy_busy_buffers_size   256k;\n        proxy_temp_file_write_size 256k;\n        proxy_headers_hash_bucket_size 128;\n        proxy_headers_hash_max_size 512;\n\n        proxy_set_header Host       $host;\n        proxy_set_header X-Real-IP  $remote_addr;\n        proxy_set_header X-Forwarded-Uri $request_uri;\n        proxy_redirect off;\n\n        proxy_pass http://127.0.0.1:4180/oauth2/;\n    }\n\n    # Serve static content directly\n    location ~* \\.(js|css|json|gif|jpe?g|png)$ {\n        try_files $uri =404;\n        expires 30d;\n        add_header Cache-Control \"public, max-age=2592000\";\n    }\n\n    # Make sure /assets do not get redirected\n    location /assets/ {\n        try_files $uri =404;\n    }\n\n    location ~ \\.html$ {\n        add_header Content-Type \"text/html; charset=UTF-8\";\n    }\n\n    # This is our kubectl proxy\n    location /k8s {\n        include /etc/nginx/auth.d/*.conf;\n\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n        proxy_set_header Authorization \"\";\n        proxy_pass_request_body on;\n        proxy_pass_request_headers on;\n        client_max_body_size 5g;\n\n        # Websocket for console and VNC\n        proxy_set_header Upgrade $http_upgrade;\n        proxy_set_header Connection $connection_upgrade;\n\n        # Longer timeouts\n        proxy_read_timeout 86400s;\n        proxy_send_timeout 86400s;\n        proxy_connect_timeout 86400s;\n\n        proxy_buffering off;\n        proxy_request_buffering off;\n        proxy_http_version 1.1;\n\n        proxy_pass http://127.0.0.1:8001/k8s;\n    }\n\n    location /internal-auth/ {\n        internal;\n        proxy_pass_request_body off;\n        proxy_set_header Content-Length \"\";\n        proxy_buffer_size   128k;\n        proxy_buffers   16 256k;\n        proxy_busy_buffers_size   256k;\n        proxy_temp_file_write_size 256k;\n        proxy_headers_hash_bucket_size 128;\n        proxy_headers_hash_max_size 512;\n\n        proxy_set_header Host       $host;\n        proxy_set_header X-Real-IP  $remote_addr;\n        proxy_set_header X-Forwarded-Uri $request_uri;\n\n        proxy_pass http://127.0.0.1:4180/oauth2/auth;\n    }\n\n    # Other locations (e.g. Prometheus)\n    include /etc/nginx/location.d/*.conf;\n\n    # Angular SPA\n    location / {\n        # Fix 404s on Single Page Application\n        try_files $uri $uri/ /index.html;\n        include /etc/nginx/auth.d/*.conf;\n    }\n}\n"]},"service.kubevirt-manager.controller":{"0":["kubevirt-manager"]},"service.kubevirt-manager.ports.http.port":{"0":["8080"]},"ingress.kubevirt-manager.enabled":{"0":["true"]},"ingress.kubevirt-manager.annotations.haproxy#org/allow-list":{"0":["${HAPROXY_WHITELIST}"]},"ingress.kubevirt-manager.annotations.haproxy#org/ssl-redirect-port":{"0":["443"]},"ingress.kubevirt-manager.annotations.haproxy#org/timeout-client":{"0":["86400s"]},"ingress.kubevirt-manager.annotations.haproxy#org/timeout-server":{"0":["86400s"]},"ingress.kubevirt-manager.annotations.haproxy#org/timeout-tunnel":{"0":["86400s"]},"ingress.kubevirt-manager.annotations.haproxy#org/response-set-header":{"0":["Strict-Transport-Security \"max-age=31536000\"\nX-Content-Type-Options \"nosniff\"\nReferrer-Policy \"strict-origin-when-cross-origin\"\n"]},"ingress.kubevirt-manager.hosts[].host":{"0":["kubevirt-manager.${SECRET_DEFAULT_DOMAIN}"]},"ingress.kubevirt-manager.hosts[].paths[].path":{"0":["/"]},"ingress.kubevirt-manager.hosts[].paths[].service.identifier":{"0":["kubevirt-manager"]},"ingress.kubevirt-manager.hosts[].paths[].service.port":{"0":["http"]},"ingress.kubevirt-manager.tls[].hosts[]":{"0":["kubevirt-manager.${SECRET_DEFAULT_DOMAIN}"]},"persistence.nginx-cache.enabled":{"0":["true"]},"persistence.nginx-cache.type":{"0":["emptyDir"]},"persistence.nginx-cache.globalMounts[].path":{"0":["/var/cache/nginx"]},"persistence.nginx-run.enabled":{"0":["true"]},"persistence.nginx-run.type":{"0":["emptyDir"]},"persistence.nginx-run.globalMounts[].path":{"0":["/var/run"]},"persistence.nginx-tmp.enabled":{"0":["true"]},"persistence.nginx-tmp.type":{"0":["emptyDir"]},"persistence.nginx-tmp.globalMounts[].path":{"0":["/tmp"]},"persistence.oauth-config.enabled":{"0":["true"]},"persistence.oauth-config.type":{"0":["secret"]},"persistence.oauth-config.name":{"0":["kubevirt-manager-oauth"]},"persistence.oauth-config.advancedMounts.kubevirt-manager.kubevirt-manager[].path":{"0":["/etc/nginx/oauth.d/oauth2.conf"]},"persistence.oauth-config.advancedMounts.kubevirt-manager.kubevirt-manager[].subPath":{"0":["oauth2.conf"]},"persistence.oauth-config.advancedMounts.kubevirt-manager.kubevirt-manager[].readOnly":{"0":["true"]},"persistence.auth-config.enabled":{"0":["true"]},"persistence.auth-config.type":{"0":["configMap"]},"persistence.auth-config.name":{"0":["kubevirt-manager"]},"persistence.auth-config.advancedMounts.kubevirt-manager.kubevirt-manager[].path":{"0":["/etc/nginx/auth.d/oauth2.conf","/etc/nginx/